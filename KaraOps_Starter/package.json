{
  "name": "karaops",
  "version": "0.8.0",
  "productName": "KaraOps",
  "private": true,
  "description": "Portable, read-only Daggerfall Online Dungeon Hunter",
  "main": "./out/main/index.js",
  "author": "KaraOps",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "portable": "npm run build && electron-builder --win portable --x64",
    "preview": "electron-vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:hunter:local": "node --test tests/hunter-local.mjs",
    "test:geometry:local": "node --test tests/geometry-local.mjs",
    "test:world:local": "node --test tests/world-local.mjs",
    "test:jackpot:local": "node --test tests/jackpot-local.mjs",
    "test:navigation:v07:local": "node --test tests/navigation-v07-local.mjs",
    "test:live": "node --test tests/live.test.mjs",
    "test:orrery:local": "node --test tests/orrery-source-local.mjs"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
